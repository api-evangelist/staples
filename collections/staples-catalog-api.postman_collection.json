  "info": {
    "_postman_id": "610f7b39-07ba-4ac4-8389-253d419402a9",
    "name": "Staples Advantage eProcurement Account Catalog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Staples Advantage eProcurement API enables enterprise procurement integration for business customers. Partners can search the Staples product catalog, manage orders, track deliveries, and access account information. Supports integration with over 170 eProcurement platforms including Ariba, Coupa, Jaggaer, and Oracle for streamlined office supply procurement.\n\nContact Support:\n Name: Staples Business Advantage Support",
      "type": "text/plain"
    }
  }
